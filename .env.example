OPENAI_API_KEY=
GEMINI_API_KEY=
LUMA_API_KEY=
DEFAULT_IMAGE_PROVIDER=gemini
DEFAULT_VIDEO_PROVIDER=luma
USE_MOCK_AI=false
PUBLIC_ASSET_BASE_URL=

# PUBLIC_ASSET_BASE_URL must be a public HTTPS URL for real Luma image-to-video.
# Keep API keys only in backend/server environment variables. Do not expose them in app.js or index.html.
# USE_MOCK_AI=false keeps mock video disabled unless the user explicitly confirms it in the app.
